# /etc/sd/fetch.env — root:llama 0640. Read by sd-fetch.service.
# Shared secret; LLMUI keeps the same value in ~/.llmui/sd-fetch.token.
SD_FETCH_TOKEN=
# Optional: a Hugging Face read token, only for gated/private repos.
HF_TOKEN=
SD_MODEL_DIR=/var/lib/sd/models
SD_FETCH_BIND=100.118.190.15
SD_FETCH_PORT=8083
SD_FETCH_RESERVE_GB=10
