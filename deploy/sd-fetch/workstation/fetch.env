# /etc/sd/fetch.env on the workstation — root:root 0600. Read by sd-fetch.service.
# SD_FETCH_TOKEN is filled in by: sudo python3 -I /opt/sd-fetch/sd-fetch.py --init-env /etc/sd/fetch.env
# LLMUI keeps the same value in ~/.llmui/workstation-fetch.token.
SD_FETCH_TOKEN=
# Optional: a Hugging Face read token, only for gated/private repos.
HF_TOKEN=
SD_MODEL_DIR=/var/lib/sd/models
# Used only when not socket-activated.
SD_FETCH_BIND=100.126.189.91
SD_FETCH_PORT=8083
SD_FETCH_RESERVE_GB=10
SD_FETCH_GPU=nvidia
